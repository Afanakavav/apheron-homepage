rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leads collection for Studio Legale Taiti contact form
    match /leads/{leadId} {
      // Allow creation for contact form submissions
      // Basic validation: nome, email, and messaggio must be present
      allow create: if request.resource.data.keys().hasAll(['nome', 'email', 'messaggio'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() <= 200
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*\\..*')
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.messaggio is string
                    && request.resource.data.messaggio.size() > 0
                    && request.resource.data.messaggio.size() <= 5000;
      
      // Allow read for debugging (can be restricted later)
      // Only authenticated users can update/delete
      allow read: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Other collections (keep existing rules)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

